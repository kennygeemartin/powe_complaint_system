{
  "name": "powerresolve-cloudflare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-responsive electricity complaints research application on Cloudflare Workers, D1 and R2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply powerresolve-db --local",
    "db:remote": "wrangler d1 migrations apply powerresolve-db --remote",
    "deploy:raw": "wrangler deploy",
    "deploy:prepare": "node scripts/deploy.mjs --prepare-only",
    "build:pwa": "node scripts/build-pwa-icons.mjs",
    "predeploy": "npm run build:pwa",
    "pretest": "npm run build:pwa",
    "admin:key": "node scripts/bootstrap-admin.mjs --generate-key",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
