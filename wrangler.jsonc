{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "powe-complaint-system",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "powerresolve-db",
      "database_id": "690bcbd3-1028-4ac2-81e9-e1473c368c58",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "powerresolve-evidence"
    }
  ],
  "observability": {
    "enabled": true
  }
}
